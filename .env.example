# --- Base de datos ---
# DATABASE_URL: la que usa la app en runtime.
# DIRECT_URL:   la que usan las migraciones y el seed (Prisma Migrate no
#               funciona a través del pooler en modo transacción).
# En local ambas apuntan a lo mismo:
DATABASE_URL="postgresql://rumbo:rumbo@localhost:5432/rumbo"
DIRECT_URL="postgresql://rumbo:rumbo@localhost:5432/rumbo"

# En Supabase (Project Settings → Database → Connection string):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Sesión ---
AUTH_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio"
DEFAULT_MONEDA_REFERENCIA="USD"

# Zona horaria del proceso. Sin esto el servidor corre en UTC y las franjas
# horarias de las notificaciones salen corridas.
TZ="America/Caracas"

# --- Notificaciones push (Fase 4). Generar con: npm run vapid:generar ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:tu@correo.com"

# Secreto que exige el endpoint del job de notificaciones.
CRON_SECRET=""
# Solo para el worker de docker-compose; en Vercel el horario va en vercel.json.
CRON_SCHEDULE="0 * * * *"

# Tamaño del pool de conexiones. En Vercel se fuerza a 1 automáticamente.
# DB_POOL_MAX="10"
